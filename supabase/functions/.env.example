# Secrets for supabase/functions/{auth-email,send-app-email}. These are NOT
# read from a committed .env file in production — deploy them with:
#   supabase secrets set --env-file supabase/functions/.env
# (after filling in real values in a local, gitignored copy of this file).
# For local `supabase functions serve`, a `supabase/functions/.env` file is
# picked up automatically by the CLI.
#
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY do NOT need to be set here —
# every deployed edge function gets those two injected automatically.

# Resend (https://resend.com) — server-side only, never exposed to the
# frontend. Get from Resend dashboard → API Keys.
RESEND_API_KEY=

# Verified sender address on your Resend domain, e.g. "UniBuzzz <no-reply@mail.unibuzzz.app>".
# Requires the domain to be added + verified (SPF/DKIM) in Resend first.
RESEND_FROM_EMAIL=

# Public origin of the deployed web app, used to build the logo image URL
# (must be a publicly fetchable https URL for email clients to load it) and
# "open in UniBuzzz" links in app-triggered emails. e.g. https://unibuzzz.app
PUBLIC_SITE_URL=

# Shared secret Postgres sends in the `x-internal-secret` header when calling
# send-app-email via pg_net. Generate any long random string, e.g.:
#   openssl rand -hex 32
# Must be set here AND stored in Supabase Vault as `internal_email_secret`
# (see the migration + manual setup notes) with the SAME value.
INTERNAL_EMAIL_SECRET=

# Signing secret for the Auth "Send Email" hook, from Supabase dashboard →
# Authentication → Hooks → Send Email → (after selecting this function) →
# copy the "v1,whsec_..." secret shown there.
SEND_EMAIL_HOOK_SECRET=
